APP_NAME=http-metadata-inventory-service
APP_ENV=development
LOG_LEVEL=INFO

# MongoDB
MONGO_URI=mongodb://mongo:27017
MONGO_DB=metadata_inventory
MONGO_COLLECTION=metadata
MONGO_MAX_POOL_SIZE=50

# HTTP collector
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_REDIRECTS=5
HTTP_USER_AGENT=MetadataInventoryBot/1.0

# API
API_V1_PREFIX=/api/v1
STARTUP_RETRY_SECONDS=30